# Variables attendues par le serveur Express local (server.js).
# Copier ce fichier en .env et renseigner les valeurs.
# En production, ce sont des secrets Cloudflare, SANS le préfixe VITE_ :
#   npx wrangler secret put NOTION_API_KEY

VITE_NOTION_API_KEY=
VITE_NOTION_BIOGRAPHY_PAGE_ID=
VITE_NOTION_HOME_PAGE_ID=
VITE_NOTION_AGENDA_DB_ID=
VITE_NOTION_MEDIA_DB_ID=
VITE_NOTION_PRESS_DB_ID=
VITE_NOTION_REPERTOIRE_DB_ID=
VITE_NOTION_SERVICES_PAGE_ID=
VITE_NOTION_TESTIMONIALS_DB_ID=
